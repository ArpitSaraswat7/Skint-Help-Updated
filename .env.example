# ─────────────────────────────────────────────────────────────────
# Skint Help — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ─── Supabase (Required) ──────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Admin Portal (Single Owner) ─────────────────────────────────
# Only ONE admin account is supported — no database, no signup.
# Use a strong, unique password (16+ chars, mixed case, symbols).
# These values ARE bundled into the client build — use a strong
# password and rotate it regularly.
VITE_ADMIN_ID=your_admin_username
VITE_ADMIN_PASSWORD=YourStrongPasswordHere!

# Optional: Admin lockout duration in milliseconds (default: 30000 = 30s)
# VITE_ADMIN_LOCKOUT_MS=30000

# ─── EmailJS (Required for Join Us / Contact forms) ──────────────
# Found in: emailjs.com → Account → API Keys
# NOTE: These are embedded in the client bundle. Restrict allowed
# domains in your EmailJS account settings to your production domain.
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_ADMIN_TEMPLATE=your-admin-notification-template-id
VITE_EMAILJS_APPLICANT_TEMPLATE=your-applicant-confirmation-template-id
